# PlaceWise Backend Configuration

PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5433/placewise?schema=public"

# Authentication & JWT Secrets (Replace in production)
JWT_ACCESS_SECRET="placewise-access-super-secret-key-change-in-production-min32chars"
JWT_REFRESH_SECRET="placewise-refresh-super-secret-key-change-in-production-min32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Storage Settings
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# AI Provider Configuration ('mock' for testing/offline, 'openai', or 'gemini')
AI_PROVIDER="mock"
OPENAI_API_KEY="your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# Email Provider Configuration ('mock' for testing/console, or 'smtp')
EMAIL_PROVIDER="mock"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="PlaceWise Placement Cell <noreply@placewise.edu>"

# Security & CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Logging
LOG_LEVEL="info"
